{
  "name": "soroban-resurrect-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk",
    "packages/react",
    "packages/wallet-adapters",
    "packages/mock-rpc",
    "packages/example"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:sdk": "npm run build -w packages/sdk",
    "build:react": "npm run build -w packages/react",
    "build:wallet-adapters": "npm run build -w packages/wallet-adapters",
    "test": "npm run test -w packages/sdk && npm run test -w packages/react",
    "test:coverage": "npm run test:coverage -w packages/sdk && npm run test:coverage -w packages/react",
    "lint": "tsc --noEmit -p tsconfig.base.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "clean": "rm -rf packages/*/dist",
    "example": "npm run dev -w packages/example",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "semantic-release": "^24.1.0",
    "typescript": "^5.5.0"
  }
}
