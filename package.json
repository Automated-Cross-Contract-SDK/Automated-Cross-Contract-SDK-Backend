{
  "name": "soroban-resurrect-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/types",
    "packages/errors",
    "packages/footprint-parser",
    "packages/rpc",
    "packages/utils",
    "packages/core",
    "packages/sdk",
    "packages/compat",
    "packages/react",
    "packages/wallet-adapters",
    "packages/mock-rpc",
    "packages/example",
    "packages/footprint-parser-wasm",
    "packages/angular",
    "packages/vue",
    "packages/svelte",
    "packages/next",
    "packages/react-native"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:sdk": "npm run build -w packages/sdk",
    "build:react": "npm run build -w packages/react",
    "build:wallet-adapters": "npm run build -w packages/wallet-adapters",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run typecheck && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "size-limit",
    "clean": "rm -rf packages/*/dist",
    "example": "npm run dev -w packages/example",
    "licenses:sync": "node scripts/sync-licenses.mjs",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^10.3.5",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@size-limit/file": "^11.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "husky": "^9.1.6",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.3.0",
    "semantic-release": "^24.1.0",
    "size-limit": "^11.0.0",
    "typescript": "^5.5.0"
  }
}
