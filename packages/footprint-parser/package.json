{
  "name": "@soroban-resurrect/footprint-parser",
  "version": "0.1.0",
  "description": "XDR parsing and key classification for Soroban Resurrect",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Automated-Cross-Contract-SDK/Automated-Cross-Contract-SDK-Backend",
    "directory": "packages/footprint-parser"
  },
  "homepage": "https://github.com/Automated-Cross-Contract-SDK/Automated-Cross-Contract-SDK-Backend#readme",
  "bugs": "https://github.com/Automated-Cross-Contract-SDK/Automated-Cross-Contract-SDK-Backend/issues",
  "keywords": [
    "stellar",
    "soroban",
    "smart-contracts",
    "state-restoration",
    "xdr",
    "footprint"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "@soroban-resurrect/types": "^0.1.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "tsup": "^8.3.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
