# The monorepo intentionally spans peer ranges that npm's strict resolver
# cannot satisfy in a single hoisted tree (React 18 for @soroban-resurrect/react
# vs React 19 required by react-native; vitest 2 for most packages vs vitest 5
# in footprint-parser). Use npm's legacy (npm 6) peer resolution, which is how
# the committed lockfile is generated, so `npm ci` stays reproducible.
legacy-peer-deps=true
